   "grammar": {
    "title": "am / is / are 都是「是」",
    "intro": "它们都表示「是」，但前面的人（主语）不同，用的词就不同。",
    "points": [
     {
      "rule": "I（我）后面用 am",
      "examples": [
       {
        "en": "I am a student.",
        "zh": "我是学生。"
       },
       {
        "en": "I am happy.",
        "zh": "我很开心。"
       }
      ]
     },
     {
      "rule": "he / she / it（他、她、它）和一个人名、一个东西后面用 is",
      "examples": [
       {
        "en": "She is my friend.",
        "zh": "她是我的朋友。"
       },
       {
        "en": "My name is Li.",
        "zh": "我的名字是 Li。"
       }
      ]
     },
     {
      "rule": "you / we / they（你、我们、他们）后面用 are",
      "examples": [
       {
        "en": "They are friends.",
        "zh": "他们是朋友。"
       },
       {
        "en": "You are my friend.",
        "zh": "你是我的朋友。"
       }
      ]
     }
    ]
   },
